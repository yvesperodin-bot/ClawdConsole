# Safe Haven — Team Leader Daily Reflection
# Copy to ".env" and fill in. Never commit the real .env file.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
# Set to true only when running behind a reverse proxy / load balancer, so
# rate limiting sees the real client IP.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Access control  (REQUIRED — the form stays locked until these are set)
# ---------------------------------------------------------------------------
# Shared code given to authorized team leaders and supervisors.
ACCESS_CODE=change-me-to-a-long-random-passphrase
# Signs the session cookie. Generate with:  openssl rand -hex 32
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32
# How long a sign-in lasts.
SESSION_HOURS=12
# Set to true when served over HTTPS (recommended in production).
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Where reports are emailed  (REQUIRED for emailing)
# The team leader never types this address.
# ---------------------------------------------------------------------------
SUPERVISOR_EMAIL=supervisor@safehaven.com
MAIL_FROM=reports@safehaven.com
# Optional extra recipient, e.g. an operations mailbox. Leave blank to skip.
MAIL_CC=

# ---------------------------------------------------------------------------
# SMTP credentials  (REQUIRED for emailing — kept on the server only)
# ---------------------------------------------------------------------------
# Zoho Mail, paid custom-domain account, US data centre.
#   paid custom domain -> smtppro.zoho.com     free account -> smtp.zoho.com
#   EU -> smtppro.zoho.eu   India -> smtppro.zoho.in   Australia -> .com.au
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=587
# true for implicit TLS on port 465, false for STARTTLS on 587.
SMTP_SECURE=false
# Must be a real Zoho mailbox. MAIL_FROM must be this address or a verified
# alias on it, or Zoho refuses the message.
SMTP_USER=reports@safehaven.com
# If two-factor is on, use an app-specific password from
# accounts.zoho.com > Security > App Passwords, not the account password.
# Prefer ./scripts/make-env.sh, which takes this without echoing it.
SMTP_PASS=your-zoho-app-specific-password

# ---------------------------------------------------------------------------
# Abuse limits (per client IP)
# ---------------------------------------------------------------------------
MAX_REPORTS_PER_HOUR=12
MAX_LOGIN_ATTEMPTS=10

# ---------------------------------------------------------------------------
# Presentation
# ---------------------------------------------------------------------------
ORG_NAME=Safe Haven
# IANA timezone used for the submission timestamp, e.g. America/New_York.
REPORT_TIMEZONE=America/New_York
